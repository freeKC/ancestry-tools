 supabase/functions/indexer/index.ts      |  79 ++++++++++++-
 tests/checkpoint_test.ts                 |  54 +++++++++
 tests/indexer_orchestration_test.ts      | 140 +++++++++++++++++++++++
 6 files changed, 337 insertions(+), 5 deletions(-)

